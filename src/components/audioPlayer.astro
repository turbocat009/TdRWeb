---
const { audioFile } = Astro.props;
---

<div class="audio-player" data-audio-player data-audio-src={audioFile}>
    <div class="audioDiv" data-audio-content style="display: none;">
        <button
            class="playPause"
            type="button"
            aria-label="Reprodueix l'àudio"
            title="Reprodueix l'àudio"
        >
            <img src="/svg/play.svg" alt="" aria-hidden="true" />
        </button>
        <div class="bgScroll">
            <div data-scroll class="scroll"></div>
        </div>
        <p data-time>00:00</p>
        <p aria-hidden="true">/</p>
        <p data-max-time>00:00</p>
    </div>

    <div class="audioDiv" data-audio-loading>
        <h3>Carregant Àudio...</h3>
    </div>
</div>
<style is:global>
    .audio-player {
        width: 100%;
        min-width: 0;
    }

    .audioDiv {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        background-color: rgb(32, 32, 32);
        border-radius: 16px;
        width: 100%;
        min-width: 0;
        padding: 10px;
        box-sizing: border-box;
    }

    .playPause {
        flex: 0 0 46px;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 46px;
        width: 46px;
        padding: 0;
        background-color: rgb(0, 0, 0);
        border-radius: 100px;
        border: none;
        cursor: pointer;
    }

    .audio-player img {
        height: 24px;
        width: 24px;
    }

    .audio-player p {
        flex: 0 0 auto;
        margin: 0 3px;
        white-space: nowrap;
    }

    .bgScroll {
        flex: 1 1 auto;
        min-width: 0;
        overflow: hidden;
        margin: 0 12px;
        background-color: #fff;
        padding: 0;
    }

    .scroll {
        flex: 0 0 auto;
        height: 8px;
        width: 0%;
        background-color: #1f9cf1;
    }

    @media (max-width: 768px) {
        .audioDiv {
            padding: 8px;
        }

        .bgScroll {
            margin: 0 8px;
        }

        .audio-player p {
            font-size: 0.8rem;
        }
    }

    @media (max-width: 360px) {
        .bgScroll {
            margin: 0 5px;
        }

        .audio-player p {
            margin: 0 2px;
            font-size: 0.75rem;
        }
    }
</style>

<script>
    type PlayerDetail = { player: HTMLElement };

    let activeAudio: HTMLAudioElement | null = null;

    function formatTime(seconds: number) {
        const minutes = String(Math.floor(seconds / 60)).padStart(2, "0");
        const remainingSeconds = String(Math.floor(seconds % 60)).padStart(
            2,
            "0",
        );
        return `${minutes}:${remainingSeconds}`;
    }

    function initializePlayer(player: HTMLElement) {
        const source = player.dataset.audioSrc;
        const content = player.querySelector<HTMLElement>("[data-audio-content]");
        const loading = player.querySelector<HTMLElement>("[data-audio-loading]");
        const durationText = player.querySelector<HTMLElement>("[data-time]");
        const maxDurationText = player.querySelector<HTMLElement>("[data-max-time]");
        const scroll = player.querySelector<HTMLElement>("[data-scroll]");
        const button = player.querySelector<HTMLButtonElement>(".playPause");
        const playImage = player.querySelector<HTMLImageElement>(".playPause img");

        if (!source || !content || !loading || !durationText || !maxDurationText || !scroll || !button || !playImage) {
            return;
        }

        activeAudio?.pause();
        const audio = new Audio(source);
        audio.preload = "metadata";
        activeAudio = audio;
        content.style.display = "none";
        loading.style.display = "flex";
        scroll.style.width = "0%";
        durationText.textContent = "00:00";
        playImage.src = "/svg/play.svg";
        button.setAttribute("aria-label", "Reprodueix l'àudio");
        button.title = "Reprodueix l'àudio";

        audio.addEventListener("loadedmetadata", () => {
            maxDurationText.textContent = formatTime(audio.duration);
            content.style.display = "flex";
            loading.style.display = "none";
        }, { once: true });

        audio.addEventListener("timeupdate", () => {
            durationText.textContent = formatTime(audio.currentTime);
            scroll.style.width = audio.duration
                ? `${(audio.currentTime / audio.duration) * 100}%`
                : "0%";
        });

        audio.addEventListener("play", () => {
            playImage.src = "/svg/pause.svg";
            button.setAttribute("aria-label", "Pausa l'àudio");
            button.title = "Pausa l'àudio";
        });

        const showPlayIcon = () => {
            playImage.src = "/svg/play.svg";
            button.setAttribute("aria-label", "Reprodueix l'àudio");
            button.title = "Reprodueix l'àudio";
        };

        audio.addEventListener("pause", showPlayIcon);
        audio.addEventListener("ended", showPlayIcon);

        button.onclick = async () => {
            if (audio.paused) {
                try {
                    await audio.play();
                } catch {
                    showPlayIcon();
                }
            } else {
                audio.pause();
            }
        };

        audio.addEventListener("error", () => {
            loading.textContent = "No s'ha pogut carregar l'àudio.";
        }, { once: true });
    }

    document.querySelectorAll<HTMLElement>("[data-audio-player]").forEach(initializePlayer);

    document.addEventListener("audio-player:init", (event) => {
        const player = (event as CustomEvent<PlayerDetail>).detail?.player;
        if (player) {
            initializePlayer(player);
        }
    });

    for (const eventName of [
        "red-button:press",
        "orange-button:press",
        "green-button:press",
    ]) {
        document.addEventListener(eventName, () => {
            activeAudio?.pause();
        });
    }
</script>
