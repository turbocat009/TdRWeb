---
const { audioFile } = Astro.props;
---

<div class="audioDiv" id="content" style="display: none;">
    <button class="playPause" id="play">
        <img src="/svg/play.svg" id="playIMG" alt="Play | Pause button" />
    </button>
    <div class="audioDiv bgScroll">
        <div id="scroll" class="audioDiv scroll"></div>
    </div>
    <p id="time">88:88</p>
    <p>/</p>
    <p id="maxTime">88:88</p>
</div>

<div class="audioDiv" id="load">
    <h3>Loading Audio...</h3>
</div>
<div data-message={audioFile} class="none" id="fileLoc"></div>
<style is:global>
    .audioDiv {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        background-color: rgb(32, 32, 32);
        border-radius: 16px;
        width: 90%;
        padding: 10px;
    }

    .playPause {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 46px;
        width: 46px;
        padding: 0;
        background-color: rgb(0, 0, 0);
        border-radius: 100px;
        border: none;
        cursor: pointer;
    }

    img {
        height: 24px;
        width: 24px;
    }

    .none {
        display: none;
    }

    .bgScroll {
        display: flex;
        justify-content: start;
        width: 75%;
        margin: 0 15px 0 15px;
        background-color: #fff;
        padding: 0;
    }

    .scroll {
        margin: 0;
        padding: 10px 0 10px 0;
        height: 100%;
        width: 0%;
        background-color: #1f9cf1;
    }
</style>

<script>
    const maxDurationText = document.getElementById("maxTime");
    const durationText = document.getElementById("time");
    const scroll = document.getElementById("scroll");
    const buttonPlay = document.getElementById("play");
    const buttonPlayIMG = document.getElementById("playIMG");
    const content = document.getElementById("content");
    const loading = document.getElementById("load");
    const fileLoc = document.getElementById("fileLoc");

    let audio = new Audio("/audio/Chopin.wav");
    let response = await fetch("/audio/Chopin.wav");

    if (fileLoc) {
        audio = new Audio(fileLoc.dataset.message);
        response = await fetch(fileLoc.dataset.message);
    }

    let play = false;

    const data = await response.arrayBuffer();

    const ctx = new AudioContext();
    const buffer = await ctx.decodeAudioData(data);

    const maxTimeMins = String(Math.floor(buffer.duration / 60)).padStart(
        2,
        "0",
    );
    const maxTimeSecs = String(
        Math.round(buffer.duration - Number(maxTimeMins) * 60),
    ).padStart(2, "0");

    let timeMins = String(Math.floor(audio.currentTime / 60)).padStart(2, "0");
    let timeSecs = String(
        Math.round(audio.currentTime - Number(timeMins) * 60),
    ).padStart(2, "0");

    const playImage = buttonPlayIMG as HTMLImageElement;

    maxDurationText.textContent = maxTimeMins + ":" + maxTimeSecs;

    function loop() {
        if (buffer.duration != 0) {
            content.style.display = "flex";
            loading.style.display = "none";
        }

        timeMins = String(Math.floor(audio.currentTime / 60)).padStart(2, "0");
        timeSecs = String(
            Math.round(audio.currentTime - Number(timeMins) * 60),
        ).padStart(2, "0");

        durationText.textContent = timeMins + ":" + timeSecs;

        scroll.style.width = `${(audio.currentTime / buffer.duration) * 100}%`;

        if (play) {
            audio.play();
        } else {
            audio.pause();
        }

        requestAnimationFrame(loop);
    }

    buttonPlay.onclick = function () {
        play = !play;
        if (play) {
            playImage.src = "/svg/pause.svg";
        } else {
            playImage.src = "/svg/play.svg";
        }
    };

    loop();
</script>
