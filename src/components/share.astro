---
import RedButton from "../components/redButton.astro";
import GreenButton from "../components/greenButton.astro";
---

<main id="shareModal" class="modal-hidden">
    <div class="main" id="main">
        <h1>Share Your Results</h1>
        <div class="containter1">
            <form>
                <input
                    class="name"
                    type="text"
                    id="name"
                    placeholder="E-Mail..."
                />
                <textarea
                    class="otherInfo"
                    id="otherInfo"
                    rows="4"
                    placeholder="Altra informació rellevant..."></textarea>
                <GreenButton text="Compartir" onPress="submitShare" />
                <RedButton
                    text="Tancar"
                    onPress="closeShare"
                    class="small-red-button"
                />
            </form>
        </div>
    </div>
</main>
<div class="thank-you-overlay" id="thankYou">
    <h1>Gràcies per compartir els teus resultats!</h1>
</div>

<style>
    main {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(32, 32, 32, 0.75);
        backdrop-filter: blur(5px);
        z-index: 1000;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: auto;
    }

    .modal-hidden {
        display: none;
    }

    .main {
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        color: #fff;
        width: 30vw;
        height: 65vh;
        border-radius: 16px;
        align-items: center;
        justify-content: center;
        background-color: rgb(64, 64, 64);
        animation: appear 1s ease-in-out;
    }

    h1 {
    }

    div {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        justify-content: center;
        align-items: center;
    }

    .small-red-button {
        scale: 0.8;
    }

    h2 {
        background-color: rgb(64, 64, 64);
        margin: 0;
        width: 100%;
        height: 100%;
        border-radius: 10000px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        cursor: default;
        user-select: none;
    }

    form {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 1.2rem;
    }

    h3 {
        margin: 1rem;
        text-align: center;
        color: #ccc;
    }

    .fade-out {
        animation: 0.5s fade-out linear;
        opacity: 0;
    }

    .thank-you {
        display: none;
        color: #fff;
        font-size: 1.5rem;
        text-align: center;
    }

    .thank-you-overlay {
        position: absolute;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 24px;
        box-sizing: border-box;
        color: #fff;
        text-align: center;
        background-color: rgba(32, 32, 32, 0.75);
        backdrop-filter: blur(5px);
        z-index: 1000;
    }

    .containter1 {
        display: flex;
        flex-direction: column;
        width: 90%;
        justify-content: space-around;
        padding-bottom: 25px;
    }

    .name {
        width: 360px;
        height: 45px;
        padding: 0 20px;
        border-radius: 16px;
        font-size: 2rem;
        font-weight: 600;
        color: #000;
        border: none;
        background-color: #fff;
        box-shadow: 0 10px 0 #6c2aa4;
        cursor: pointer;
        transition: 0.05s all ease-in-out;
    }

    .name:hover {
        background-color: #e6e6e6;
    }

    .name:focus {
        transform: translateY(2px);
        background-color: #d9d9d9;
        box-shadow: 0 7px 0 #6c2aa4;
    }

    .otherInfo {
        width: 360px;
        padding: 0 20px;
        border-radius: 16px;
        font-size: 2rem;
        font-weight: 600;
        color: #000;
        border: none;
        background-color: #fff;
        box-shadow: 0 10px 0 #6c2aa4;
        cursor: pointer;
        transition: 0.05s all ease-in-out;
        margin-bottom: 1.5rem;
    }

    .otherInfo:hover {
        background-color: #e6e6e6;
    }

    .otherInfo:focus {
        transform: translateY(2px);
        background-color: #d9d9d9;
        box-shadow: 0 7px 0 #6c2aa4;
    }

    @keyframes fade-out {
        0% {
            opacity: 1;
            display: flex;
        }
        99% {
            opacity: 0;
        }
        100% {
            opacity: 0;
            display: none;
        }
    }

    @keyframes appear {
        from {
            transform: translateY(50px);
            opacity: 0.25;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    @media (max-width: 768px) {
        main {
            padding: 16px;
            box-sizing: border-box;
        }

        .main {
            width: min(100%, 420px);
            height: auto;
            max-height: calc(100vh - 32px);
            padding: 24px 16px 32px;
            box-sizing: border-box;
        }

        .main h1,
        .thank-you-overlay h1 {
            font-size: 1.6rem;
            text-align: center;
        }

        .containter1,
        form {
            width: 100%;
        }

        .name,
        .otherInfo {
            width: 100%;
            box-sizing: border-box;
            font-size: 1.1rem;
        }

        .otherInfo {
            min-height: 120px;
        }

        form button {
            width: min(100%, 250px);
            height: 60px;
            font-size: 1.4rem;
        }
    }
</style>

<script>
    import { supabase } from "../lib/supabase";

    const shareModal = document.getElementById("shareModal");
    const nameInput = document.getElementById("name");
    const otherInfoInput = document.getElementById("otherInfo");

    async function saveText() {
        if (!nameInput.value) {
            alert("Introdueix el teu mail")
            return false;
        }

        const { data, error } = await supabase
            .from("results")
            .insert({
                name: nameInput.value,
                other_info: otherInfoInput.value,
                response: JSON.stringify(sessionStorage.getItem("results")),
            })
            .select();

        if (error) {
            console.error("Insert failed:", error);
            return false;
        }

        console.log("Saved:", data);
        return true;
    }

    async function submitShare() {
        const saved = await saveText();

        if (!saved) {
            return;
        }

        const form = document.querySelector("#shareModal form");
        const thankYou = document.getElementById("thankYou");
        form?.setAttribute("hidden", "true");
        thankYou?.style.setProperty("display", "block");
        sessionStorage.clear();

        await new Promise((resolve) => setTimeout(resolve, 1500));
        shareModal?.classList.add("fade-out");
        await new Promise((resolve) => setTimeout(resolve, 500));
        window.location.href = "https://www.google.com";
    }

    document.addEventListener("green-button:press", (event) => {
        if (event instanceof CustomEvent && event.detail === "openShare") {
            shareModal?.classList.remove("modal-hidden", "fade-out");
        }

        if (event instanceof CustomEvent && event.detail === "submitShare") {
            submitShare();
        }
    });

    document.addEventListener("red-button:press", async (event) => {
        if (event instanceof CustomEvent && event.detail === "closeShare") {
            shareModal?.classList.add("fade-out");
            await new Promise((resolve) => setTimeout(resolve, 500));
            shareModal?.classList.add("modal-hidden");
            shareModal?.classList.remove("fade-out");
        }
    });
</script>
