---
const { text, onPress } = Astro.props;
---

<button type="button" class="buttonGreen" data-on-press={onPress}>{text}</button>

<style is:global>
    .buttonGreen {
        width: 250px;
        height: 77px;
        border-radius: 16px;
        font-size: 2rem;
        font-weight: 600;
        color: #fff;
        border: none;
        background-color: #248e3b;
        box-shadow: 0 10px 0 #175724;
        cursor: pointer;
        transition: 0.05s all ease-in-out;
    }

    .buttonGreen:hover {
        background-color: #1f7b33;
    }

    .buttonGreen:active {
        transform: translateY(5px);
        background-color: #175b26;
        box-shadow: 0 5px 0 #175724;
    }

    @media (max-width: 768px) {
        .buttonGreen {
            width: 200px;
            height: 60px;
            font-size: 1.5rem;
        }
    }
</style>

<script>
    document.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
            "button.buttonGreen[data-on-press]",
        );
        const functionName = button?.dataset.onPress;

        if (functionName) {
            document.dispatchEvent(
                new CustomEvent("green-button:press", {
                    detail: functionName,
                }),
            );
        }
    });
</script>
