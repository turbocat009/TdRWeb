---
import Layout from "../layouts/Layout.astro";
import RedButton from "../components/redButton.astro";
import OrangeButton from "../components/orangeButton.astro";
import GreenButton from "../components/greenButton.astro";
import AudioPlayer from "../components/audioPlayer.astro";
---

<Layout title="Test">
    <div class="counter">1/1</div>
    <main class="">
        <h1>1st Audio</h1>
        <AudioPlayer />
        <div>
            <RedButton text="Not Modified" />
            <OrangeButton text="I don't know" />
            <GreenButton text="Modified" />
        </div>
    </main>
</Layout>

<style>
    main {
        padding: 40px 40px 50px 40px;
        margin: 0;
        display: flex;
        flex-direction: column;
        color: #fff;
        border-radius: 16px;
        align-items: center;
        background-color: rgb(64, 64, 64);
        animation: start 2s linear;
    }

    div {
        display: flex;
        flex-direction: row;
        gap: 1rem;
        margin-top: 25px;
    }

    .counter {
        position: absolute;
        bottom: 15px;
        background-color: rgb(64, 64, 64);
        color: #fff;
        padding: 15px 30px 15px 30px;
        border-radius: 32px;
        font-size: 1.2rem;
        opacity: 1;
        animation: fade-in 1s linear;
        cursor: default;
    }

    .none {
        display: none;
    }

    @keyframes fade-in {
        from {
            opacity: 0;
            transform: translateY(50px);
        }
        to {
            opacity: 1;
            transform: translateY(0px);
        }
    }

    @keyframes start {
        from {
            transform: translateY(-1050px);
        }
        to {
            transform: translateY(0px);
        }
    }
</style>
