---
import Layout from "../layouts/Layout.astro";
import RedButton from "../components/redButton.astro";
import GreenButton from "../components/greenButton.astro";
import Share from "../components/share.astro";

import { questions } from "../consts/questions";
---
<Layout title="Resultats">
    <Share />
    <main id="main">
        <h1>Els teus resultats</h1>
        <div class="containter1">
            <div class="round">
                <h2>∞/6</h2>
            </div>
            <div class="container2">
                <p>∞ correctes</p>
                <p>∞ incorrectes</p>
                <p>∞ no resposta</p>
            </div>
        </div>
        <div style="display: none;">
            <h3>
                Ens seria de molta ajuda que ens compartissis els teus resultats
            </h3>
            <GreenButton text="Compartir" onPress="openShare" />
            <RedButton text="Sortir" onPress="exit" class="small-red-button" />
        </div>
    </main>
    <div
        style="display: none;"
        id="secret"
        data-questions={JSON.stringify(questions)}
    >
    </div>
</Layout>

<script>
    const main = document.getElementById("main");
    const correctField = document.querySelector(".container2 > p:nth-child(1)");
    const incorrectField = document.querySelector(".container2 > p:nth-child(2)");
    const notKnownField = document.querySelector(".container2 > p:nth-child(3)");
    const circle = document.querySelector(".round > h2");
    const secret = document.getElementById("secret");
    const questions = JSON.parse(secret?.dataset.questions ?? "[]");

    getResults();

    function leave() {
        window.location.href = "https://www.google.com";
    }

    function getResults() {
        const results = sessionStorage.getItem("results");
        if (results) {
            const parsedResults = JSON.parse(results);
            console.log(parsedResults);

            let correct = 0;
            let incorrect = 0;
            let notKnown = 0;

            for (let i = 0; i < parsedResults.length; i++) {
                const answer = parsedResults[i];
                if (answer === questions[i].correctAnswer) {
                    correct++;
                } else if (answer === 2) {
                    notKnown++;
                } else {
                    incorrect++;
                }
            }

            correctField.textContent = `${correct} correctes`;
            incorrectField.textContent = `${incorrect} no correctes`;
            notKnownField.textContent = `${notKnown} no conegudes`;
            circle.textContent = `${correct}/${questions.length}`;
        } else {
            window.location.href = "/";
        }

    }

    document.addEventListener("red-button:press", async (event) => {
        if (event instanceof CustomEvent && event.detail === "exit") {
            main?.classList.add("fade-out");
            await new Promise((resolve) => setTimeout(resolve, 500));
            leave();
        }
    });
</script>

<style>
    main {
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        color: #fff;
        width: min(30vw, 560px);
        height: min(60vh, 620px);
        box-sizing: border-box;
        border-radius: 16px;
        align-items: center;
        justify-content: center;
        background-color: rgb(64, 64, 64);
        animation: appear 1s ease-in-out;
    }

    h1 {
        margin-top: 0;
    }

    div {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        justify-content: center;
        align-items: center;
    }

    .small-red-button {
        scale: 0.8;
    }

    h2 {
        background-color: rgb(64, 64, 64);
        margin: 0;
        width: 100%;
        height: 100%;
        border-radius: 10000px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        cursor: default;
        user-select: none;
    }

    h3 {
        margin: 1rem;
        text-align: center;
        color: #ccc;
    }

    .round {
        background-color: #eee;
        border-radius: 1000px;
        padding: 2px;
        width: 100px;
        height: 100px;
        margin: 0;
    }

    .fade-out {
        animation: 0.2s fade-out linear;
        opacity: 0;
    }

    .containter1 {
        display: flex;
        flex-direction: row;
        width: 90%;
        justify-content: space-around;
        padding-bottom: 25px;
    }

    .container2 {
        display: flex;
        gap: 0;
        justify-content: start;
        align-items: start;
    }

    .container2 > p {
        margin: 10px;
        font-size: 1rem;
        font-weight: 600;
    }

    main button {
        max-width: 100%;
    }

    @media (max-width: 768px) {
        main {
            width: calc(100vw - 32px);
            height: auto;
            min-height: 70vh;
            max-height: calc(100vh - 32px);
            padding: 24px 16px 32px;
            overflow-y: auto;
        }

        main h1 {
            font-size: 1.8rem;
            text-align: center;
        }

        .containter1 {
            width: 100%;
            flex-direction: column;
            gap: 1rem;
            padding-bottom: 18px;
        }

        .container2 {
            width: 100%;
            gap: 0.25rem;
            align-items: center;
        }

        .container2 > p {
            margin: 4px;
            text-align: center;
        }

        .round {
            width: 88px;
            height: 88px;
        }

        main > div:last-child {
            width: 100%;
        }

        h3 {
            max-width: 100%;
            font-size: 1rem;
            line-height: 1.4;
        }

        main button {
            width: min(100%, 250px);
            height: 60px;
            font-size: 1.4rem;
        }
    }

    @keyframes fade-out {
        from {
            opacity: 1;
        }
        to {
            opacity: 0;
        }
    }

    @keyframes appear {
        from {
            transform: translateY(50px);
            opacity: 0.25;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }
</style>
